Options -Indexes
AddDefaultCharset UTF-8
php_flag display_errors off
RewriteEngine On

RewriteCond %{REQUEST_URI} ^/admin/post/blog/galeri/image-upload\.php$
RewriteRule ^(.*)$ $1 [L]

RewriteBase /

# --- Trailing slash removal (with or without query string) ---
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)/$ /$1 [R=301,L,QSA]

# --- /blogs/ → /blog redirect ---
RewriteRule ^blogs/?$ /blog [R=301,L]

# --- Root-level query param redirects (duplicate canonical fix) ---
RewriteCond %{QUERY_STRING} ^transmissie=([^&]+)$
RewriteRule ^$ /zoek?transmissie=%1 [R=301,L,NE]

RewriteCond %{QUERY_STRING} ^post_type=vehica_car&p=([0-9]+)$
RewriteRule ^$ / [R=301,L]

# --- /zoek/ current-page param → clean /page/N URL ---
RewriteCond %{QUERY_STRING} ^(.*&)?current-page=([0-9]+)(&.*)?$
RewriteRule ^(zoek)/?$ /$1/page/%2?%1%3 [R=301,L,NE]

# --- /zoek?brand=X&type=Y → /zoek/X/Y ---
RewriteCond %{THE_REQUEST} \s/+(?:zoek|carlist)(?:\.php)?\?brand=([^&\s]+)&type=([^&\s]+) [NC]
RewriteRule ^ /zoek/%1/%2? [R=301,L,NE]

# --- /zoek?brand=X → /zoek/X ---
RewriteCond %{THE_REQUEST} \s/+(?:zoek|carlist)(?:\.php)?\?brand=([^&\s]+) [NC]
RewriteRule ^ /zoek/%1? [R=301,L,NE]

# --- Force www ---
RewriteCond %{HTTP_HOST} !^www.umtcar.be [NC]
RewriteRule ^(.*)$ https://www.umtcar.be/$1 [L,R=301]

RewriteRule ^xmlmap\.php$ xmlmap.php [L,NC]
RewriteRule ^sitemap\.xml$ xmlmap.php [L,NC]
RewriteRule ^includes/api-reviews$ includes/api-reviews.php [L,NC]
RewriteRule ^post/cars/filter$ post/cars/filter.php [L,NC]
RewriteRule ^includes/optimize/?$ includes/optimize.php [L,NC]
RewriteRule ^includes/thumb/?$ includes/thumb.php [L,NC]
RewriteRule ^includes/test-thumb/?$ includes/test-thumb.php [L,NC]
RewriteRule ^includes/update_cache/?$ includes/update_cache.php [L,NC]
RewriteRule ^optimizer\.php$ optimizer.php [L,NC]

RewriteCond %{REQUEST_URI} !^/xmlmap\.php$
RewriteCond %{REQUEST_URI} !^/sitemap\.xml$
RewriteCond %{REQUEST_URI} !^/includes/api-reviews\.php$
RewriteCond %{REQUEST_URI} !^/resize/car\.php$
RewriteCond %{THE_REQUEST} \s/([^.]+)\.php [NC]
RewriteRule ^ /%1 [R=301,L]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^admin/?$ admin/login.php [L]
RewriteRule ^admin/login/?$ admin/login.php [L]

RewriteCond %{REQUEST_URI} !\.php$
RewriteRule ^admin/(.+)$ admin/$1.php [L,QSA]

RewriteRule ^zoek/([^/]+)/([^/]+)/page/([0-9]+)/?$ carlist.php?brand=$1&type=$2&page=$3 [L,NC,QSA]
RewriteRule ^zoek/([^/]+)/page/([0-9]+)/?$ carlist.php?brand=$1&page=$2 [L,NC,QSA]
RewriteRule ^zoek/page/([0-9]+)/?$ carlist.php?page=$1 [L,NC,QSA]
RewriteRule ^zoek/([^/]+)/([^/]+)/?$ carlist.php?brand=$1&type=$2 [L,NC,QSA]
RewriteRule ^zoek/([^/]+)/?$ carlist.php?brand=$1 [L,NC,QSA]
RewriteRule ^zoek/?$ carlist.php [L,NC,QSA]
RewriteRule ^carlist/?$ carlist.php [L,QSA]

RewriteRule ^listing/([^/]+)/?$ car.php?slug=$1 [L,NC,QSA]

RewriteRule ^blog/?$ post/content/blog.php [L,NC]
RewriteRule ^category/([^/]+)/?$ post/content/category.php?slug=$1 [L,NC,QSA]
RewriteRule ^tag/([^/]+)/?$ post/content/tag.php?tag=$1 [L,NC,QSA]

RewriteCond %{REQUEST_URI} !^/zoek/
RewriteCond %{REQUEST_URI} !^/listing/
RewriteRule ^(?!admin/)([a-zA-Z0-9-]+)/?$ router.php?slug=$1 [L,NC,QSA]

RewriteRule ^$ index.php [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ 404.php [L,QSA]
